﻿@using Blazored.Toast.Services
@using ECommerceWeb.Common
@using ECommerceWeb.Common.Request
@using ECommerceWeb.Common.Response

@inject IToastService ToastService

<div class="container-fluid py-4">
    <!-- Header de la página -->
    <div class="row mb-4">
        <div class="col">
            <h2 class="h3 text-primary mb-0">
                <i class="bi bi-box me-2"></i>@Titulo
            </h2>
            <p class="text-muted mb-0">Completa la información del producto</p>
        </div>
    </div>

    <EditForm Model="Request" OnValidSubmit="Grabar">
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- Formulario de datos -->
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0 text-secondary">
                            <i class="bi bi-info-circle me-2"></i>Información del Producto
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="nombre">
                                    <i class="bi bi-tag me-1"></i>Nombre del Producto
                                </label>
                                <input type="text" id="nombre" class="form-control"
                                       @bind-value="Request.Nombre" placeholder="Ej: Laptop HP Pavilion" />
                                <ValidationMessage For="() => Request.Nombre" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="precio">
                                    <i class="bi bi-currency-dollar me-1"></i>Precio Unitario
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input type="number" id="precio" class="form-control"
                                           @bind-value="Request.PrecioUnitario" step="0.01" min="1" max="9999"
                                           placeholder="0.00" />
                                </div>
                                <ValidationMessage For="() => Request.PrecioUnitario" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold" for="descripcion">
                                    <i class="bi bi-card-text me-1"></i>Descripción
                                </label>
                                <textarea id="descripcion" class="form-control" rows="3"
                                          @bind="Request.Descripcion"
                                          placeholder="Describe las características del producto..."></textarea>
                                <ValidationMessage For="() => Request.Descripcion" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="categoria">
                                    <i class="bi bi-tags me-1"></i>Categoría
                                </label>
                                <InputSelect id="categoria" class="form-select" @bind-Value="Request.CategoriaId">
                                    <option value="0">-- Seleccione una categoría --</option>
                                    @foreach (var item in Categorias)
                                    {
                                        <option value="@item.Id">@item.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => Request.CategoriaId" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="marca">
                                    <i class="bi bi-award me-1"></i>Marca
                                </label>
                                <InputSelect id="marca" class="form-select" @bind-Value="Request.MarcaId">
                                    <option value="0">-- Seleccione una marca --</option>
                                    @foreach (var item in Marcas)
                                    {
                                        <option value="@item.Id">@item.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => Request.MarcaId" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel de imagen -->
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0 text-secondary">
                            <i class="bi bi-image me-2"></i>Imagen del Producto
                        </h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="text-center mb-3">
                            @if (Request.Base64Imagen is not null)
                            {
                                <div class="border rounded p-2 bg-light">
                                    <img src="data:image/png;base64,@Request.Base64Imagen"
                                         alt="@Request.Nombre" class="img-fluid rounded"
                                         style="max-height: 300px; object-fit: contain;" />
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(Request.UrlImagen))
                            {
                                <div class="border rounded p-2 bg-light">
                                    <img src="@Request.UrlImagen" alt="@Request.Nombre"
                                         class="img-fluid rounded"
                                         style="max-height: 300px; object-fit: contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="border rounded p-4 bg-light d-flex align-items-center justify-content-center"
                                     style="height: 200px;">
                                    <div class="text-center text-muted">
                                        <i class="bi bi-image display-4"></i>
                                        <p class="mt-2 mb-0">Sin imagen</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-auto">
                            <InputFile accept="image/png, image/jpeg, image/webp" style="display: none"
                                       id="file" OnChange="OnFileUploaded" />
                            <label for="file" class="btn btn-outline-primary w-100">
                                <i class="bi bi-camera me-2"></i>Cambiar Imagen
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de acciones -->
        <div class="row mt-4">
            <div class="col">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex gap-3 justify-content-end">
                            <button type="reset" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Guardar Producto
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <ValidationSummary />
    </EditForm>
</div>

