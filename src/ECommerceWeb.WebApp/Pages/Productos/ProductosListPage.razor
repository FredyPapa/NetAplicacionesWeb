﻿@using Blazored.Toast.Services
@using CurrieTechnologies.Razor.SweetAlert2
@using ECommerceWeb.Common
@using System.Threading.Tasks
@using ECommerceWeb.Common.Response
@using Microsoft.AspNetCore.Components.Authorization
@page "/productos/list"
@attribute [Authorize]

@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject IToastService ToastService

<PageTitle>Productos</PageTitle>

<div class="container-fluid py-4">
    <!-- Header de la página -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2 text-primary mb-0">
                <i class="bi bi-box me-2"></i>Gestión de Productos
            </h1>
            <p class="text-muted mb-0">Administra el catálogo de productos de tu tienda</p>
        </div>
    </div>

    <!-- Barra de herramientas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="filtro" class="form-label fw-semibold">
                        <i class="bi bi-search me-1"></i>Filtrar productos
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-funnel"></i>
                        </span>
                        <input id="filtro" type="text" class="form-control"
                               @bind="Filtro" placeholder="Buscar por nombre, categoría o marca..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-outline-primary w-100" @onclick="CargarDatos">
                        <i class="bi bi-arrow-clockwise me-2"></i>Actualizar
                    </button>
                </div>
                <div class="col-md-3">
                    <a class="btn btn-success w-100" href="productos/new">
                        <i class="bi bi-plus-circle me-2"></i>Nuevo Producto
                    </a>
                </div>
                <div class="col-md-2">
                    <div class="d-flex justify-content-end">
                        <span class="badge bg-primary fs-6 px-3 py-2">
                            <i class="bi bi-collection me-1"></i>@(ProductosList?.Count ?? 0)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de productos -->
    @if (ProductosList == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando productos...</p>
        </div>
    }
    else if (!ProductosList.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-box display-1 text-muted"></i>
            <h4 class="text-muted mt-3">No hay productos</h4>
            <p class="text-muted">Comienza creando tu primer producto</p>
            <a href="productos/crear" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Crear Producto
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0 text-secondary">
                    <i class="bi bi-list-ul me-2"></i>Catálogo de Productos
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">
                                <i class="bi bi-hash me-1"></i>ID
                            </th>
                            <th class="border-0">
                                <i class="bi bi-tag me-1"></i>Nombre
                            </th>
                            <th class="border-0">
                                <i class="bi bi-card-text me-1"></i>Descripción
                            </th>
                            <th class="border-0">
                                <i class="bi bi-currency-dollar me-1"></i>Precio
                            </th>
                            <th class="border-0">
                                <i class="bi bi-tags me-1"></i>Categoría
                            </th>
                            <th class="border-0">
                                <i class="bi bi-award me-1"></i>Marca
                            </th>
                            <th class="border-0 text-center">
                                <i class="bi bi-gear me-1"></i>Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ProductosList)
                        {
                            <tr class="align-middle">
                                <td>
                                    <span class="badge bg-secondary fs-6">@item.Id</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Nombre</span>
                                </td>
                                <td>
                                    <span class="text-muted">@(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)</span>
                                </td>
                                <td>
                                    <span class="badge bg-success fs-6">$@item.PrecioUnitario.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="badge bg-info">@item.Categoria</span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.Marca</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <AuthorizeView Roles="@Constantes.RolAdministrador">
                                            <Authorized>
                                                <button type="button" class="btn btn-outline-primary btn-sm"
                                                        @onclick="() => Editar(item.Id)" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => Eliminar(item.Id)" title="Eliminar">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


